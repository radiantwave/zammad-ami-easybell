# Modus: discover schreibt nur mit, bridge sendet an Zammad
MODE=bridge
AMI_HOST=jarvis.easybell.de
AMI_PORT=5039
# easybell spricht auf 5039 unverschlüsselt, obwohl das bei Asterisk der TLS-Port ist
AMI_TLS=false
AMI_USERNAME=
AMI_SECRET=
# Für MODE=bridge nötig. Aus Zammad kopieren: Admin -> Einstellungen -> Integrationen -> CTI (generic)
ZAMMAD_CTI_URL=https://helpdesk.example.de/api/v1/cti/TOKEN
